        function updateRoutesVisibility() {
            if (!globalHasActiveFilter) return;
            const bounds = map.getBounds(), center = bounds.getCenter();
            const latSpan = bounds.getNorth() - bounds.getSouth(), lngSpan = bounds.getEast() - bounds.getWest();
            const inner80Bounds = L.latLngBounds([center.lat - latSpan * 0.4, center.lng - lngSpan * 0.4], [center.lat + latSpan * 0.4, center.lng + lngSpan * 0.4]);
            
            // 使用稍长一点的延时，确保插件完成内部重绘后再操作图层
            setTimeout(() => {
                renderedRouteObjects.forEach(item => {
                    // targetOpacity 决定整条航线（含箭头）是否因为不在屏幕中心而变透明
                    const targetOpacity = (!inner80Bounds.contains(item.depCoord) && !inner80Bounds.contains(item.arrCoord)) ? 0.15 : 1; 
                    
                    // 1. 处理主线段（之前已实现）
                    item.layers.forEach(layer => { 
                        if (layer.options && layer.options.baseOpacity !== undefined) {
                            layer.setStyle({ opacity: layer.options.baseOpacity * targetOpacity }); 
                        }
                    });

                    // 2. 实时处理箭头图层 (修复嵌套图层导致的长度为1的问题)
                    if (item.decorator && typeof item.decorator.getLayers === 'function') {
                        const patternGroups = item.decorator.getLayers();
                        // 剥开第一层：拿到图案组内部的真实箭头数组
                        if (patternGroups.length > 0 && typeof patternGroups[0].getLayers === 'function') {
                            const arrowLayers = patternGroups[0].getLayers();
                            const numArrows = arrowLayers.length;
                            
                            arrowLayers.forEach((arrow, idx) => {
                                // 计算当前箭头在航线中的位置比例 (0 为起点，1 为终点)
                                const ratio = numArrows > 1 ? (idx / (numArrows - 1)) : 0;
                                // 航线本身的衰减基础透明度（从 1.0 衰减到 0.15）
                                const arrowBaseOpacity = 1.0 - (0.85 * ratio); 
                                
                                // 最终透明度 = 渐变衰减 * 视口偏离衰减
                                if (typeof arrow.setStyle === 'function') {
                                    arrow.setStyle({ opacity: arrowBaseOpacity * targetOpacity });
                                }
                            });
                        }
                    }
                });
            }, 0);
        }
