        function calculateArcPoints(start, end, curvature = 0.2) {
            const [slat, slng] = [start[0]*Math.PI/180, start[1]*Math.PI/180], [elat, elng] = [end[0]*Math.PI/180, end[1]*Math.PI/180];
            const dLng = elng - slng, bX = Math.cos(elat) * Math.cos(dLng), bY = Math.cos(elat) * Math.sin(dLng);
            const midLat = Math.atan2(Math.sin(slat) + Math.sin(elat), Math.sqrt((Math.cos(slat) + bX) * (Math.cos(slat) + bX) + bY * bY));
            const midLng = slng + Math.atan2(bY, Math.cos(slat) + bX);
            const dist = Math.sqrt(Math.pow(end[0] - start[0], 2) + Math.pow(end[1] - start[1], 2)), offset = dist * curvature;
            const pLat = -(end[1] - start[1]) / dist * offset, pLng = (end[0] - start[0]) / dist * offset;
            const cLat = (midLat * 180 / Math.PI) + pLat, cLng = (midLng * 180 / Math.PI) + pLng;
            const points = [];
            for (let i = 0; i <= 20; i++) { const t = i / 20, t1 = 1 - t; points.push([t1*t1*start[0] + 2*t1*t*cLat + t*t*end[0], t1*t1*start[1] + 2*t1*t*cLng + t*t*end[1]]); }
            return points;
        }
        
