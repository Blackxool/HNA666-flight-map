            minEl.max = totalWeeks; maxEl.max = totalWeeks; minEl.value = 0; maxEl.value = totalWeeks;
            
            function updateSlider() {
                let minVal = parseInt(minEl.value), maxVal = parseInt(maxEl.value);
                if (minVal > maxVal) { const tmp = minVal; minVal = maxVal; maxVal = tmp; }
                const minPct = (minVal / totalWeeks) * 100, maxPct = (maxVal / totalWeeks) * 100;
                const usableTrackWidth = Math.max(0, fillEl.parentElement.clientWidth - 8);
                fillEl.style.left = (4 + usableTrackWidth * minPct / 100) + 'px';
                fillEl.style.width = (usableTrackWidth * (maxPct - minPct) / 100) + 'px';
                startLbl.textContent = formatShortDate(new Date(globalMinDate.getTime() + minVal * 7 * 24 * 60 * 60 * 1000));
