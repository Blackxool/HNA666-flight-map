        function isMappedFlightVisible(mappedInfo, filters) {
            const f = mappedInfo.flight;
            if (filters.days.length > 0 && !f.days.some(d => filters.days.includes(d))) return false;
            if (filters.airlines.length === 0 || !filters.airlines.includes(f.airline)) return false;
            if (filters.aircrafts.length === 0 || !f.aircraft_type.split('/').some(t => filters.aircrafts.includes(t.trim()))) return false;
            const timeFlags = getFlightTimeFlags(f);
            if (timeFilterMode === 'legacy') {
                if (filters.times.length === 0) return false;
                if ((filters.times.includes('morning') && !timeFlags.morning) && (filters.times.includes('evening') && !timeFlags.evening)) return false;
            } else if (filters.times.length === 0) {
                if (!timeFlags.middle) return false;
            } else {
                const bothTimeFiltersSelected = filters.times.includes('morning') && filters.times.includes('evening');
                if (!bothTimeFiltersSelected) {
                    const matchesMorning = filters.times.includes('morning') && timeFlags.morning;
                    const matchesEvening = filters.times.includes('evening') && timeFlags.evening;
                    if (!matchesMorning && !matchesEvening) return false;
                }
            }
            if (f.date_range) { const ranges = parseDateRanges(f.date_range); let matchTime = false; for (let r of ranges) { if (r.start <= filters.endDateMs && r.end >= filters.startDateMs) { matchTime = true; break; } } if (!matchTime) return false; }
            if (filters.airport) {
                if (filters.dirs.length === 0) return false;
                const validTkts = f.ticketable_segments.filter(t => { const [tD, tA] = t.split('-'); let match = false; if (filters.dirs.includes('departure') && tD === filters.airport) match = true; if (filters.dirs.includes('arrival') && tA === filters.airport) match = true; return match; });
                if (validTkts.length === 0) return false;
                let inPath = false; const r = f.route, lDIdx = r.indexOf(mappedInfo.leg_dep), lAIdx = r.indexOf(mappedInfo.leg_arr);
                for (const t of validTkts) { const [tD, tA] = t.split('-'); if (lDIdx >= r.indexOf(tD) && lAIdx <= r.indexOf(tA) && lDIdx < lAIdx) { inPath = true; break; } }
                if (!inPath) return false;
            }
            return true;
        }
        
        function updateDisplay() {
            routeLayers.forEach(l => map.removeLayer(l)); routeLayers = []; renderedRouteObjects = []; const filters = getCurrentFilters();
            globalHasActiveFilter = (filters.airport !== ''); lastConnectedAirports.clear();
            
            if (globalHasActiveFilter) {
                const isDarkMode = window.matchMedia('(prefers-color-scheme: dark)').matches; const currentArrowColor = isDarkMode ? '#ffffff' : '#333333';
                generatedRoutes.forEach(rObj => {
                    const lineFlights = rObj.mapped_flights.filter(i => isMappedFlightVisible(i, filters)); if (lineFlights.length === 0) return;
                    lastConnectedAirports.add(rObj.departure); lastConnectedAirports.add(rObj.arrival);
                    const pts = rObj.arc_points; const routeUID = `rt-id-${Math.random().toString(36).substr(2, 9)}`; const segmentsLayers = [];
                    const hitboxLine = L.polyline(pts, { weight: 30, opacity: 0, className: 'route-hitbox' }).addTo(map); routeLayers.push(hitboxLine);
                    const numSegments = pts.length - 1;
                    for (let i = 0; i < numSegments; i++) {
                        const ratio = i / Math.max(1, numSegments - 1); const targetOpacity = 1.0 - (0.85 * ratio); 
                        const inL = L.polyline([pts[i], pts[i+1]], { color: rObj.color, weight: 3, opacity: targetOpacity, baseOpacity: targetOpacity, interactive: false, lineCap: 'butt', lineJoin: 'round' }).addTo(map);
                        routeLayers.push(inL); segmentsLayers.push(inL);
                    }
                    const arrowOffsetRandomness = 0.913; const randomOffset = 25 + (Math.random() * arrowOffsetRandomness * 120);
                    const dec = L.polylineDecorator(pts, { patterns: [{ offset: randomOffset, repeat: 120, symbol: L.Symbol.arrowHead({ pixelSize: 4, headAngle: 75, polygon: false, pathOptions: { color: currentArrowColor, weight: 1.5, opacity: 1, interactive: false }})}]}).addTo(map);
                    routeLayers.push(dec);
                    
                    hitboxLine.on('click', e => { L.DomEvent.stopPropagation(e); activeRouteKey = rObj.route_key; showInfoPanel(rObj.route_key, rObj.departure, rObj.arrival, rObj.mapped_flights.filter(i => isMappedFlightVisible(i, filters))); }); 
                    // 新增 decorator: dec 引用，交由 updateRoutesVisibility 全局管理
                    renderedRouteObjects.push({ depCoord: rObj.departure_coord, arrCoord: rObj.arrival_coord, layers: segmentsLayers, routeId: routeUID, decorator: dec });
                });
            }
            
            updateAirportLabels(); if(globalHasActiveFilter) updateRoutesVisibility();

            if (activeRouteKey && document.getElementById('info-panel').classList.contains('visible')) {
                if (!globalHasActiveFilter) { hideInfoPanel(); } 
                else { const c = generatedRoutes.find(r => r.route_key === activeRouteKey); const matchingFlights = c ? c.mapped_flights.filter(i => isMappedFlightVisible(i, filters)) : [];
                    if (!c || matchingFlights.length === 0) { hideInfoPanel(); } else { showInfoPanel(c.route_key, c.departure, c.arrival, matchingFlights); }
                }
            }
        }
        
        map.on('click', () => { if (document.getElementById('info-panel').classList.contains('visible')) hideInfoPanel(); });
        document.getElementById('info-panel').addEventListener('click', e => { if (e.target.closest('.flight-card')) e.stopPropagation(); else hideInfoPanel(); }); 
        map.doubleClickZoom.disable();
        
        if(airports.length > 0) { initAirports(); initializeControls(); initDateSlider(); isAppReady = true; updateDisplay(); }
    </script>
</body>
</html>
