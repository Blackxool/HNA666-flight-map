        function updateAirportLabels() {
            const zoom = map.getZoom();
            
            // 1. 调小基础排斥距离（让大机场更容易显示出来）
            const basePxDistance = zoom <= 4 ? 120 : (zoom === 5 ? 100 : (zoom === 6 ? 80 : 50));
            
            const occupiedPoints = [];

            airportMarkers.forEach(m => {
                const el = document.getElementById(`apt-marker-${m.airportIndex}`);
                if (!el) return;

                let isForced = globalHasActiveFilter ? lastConnectedAirports.has(m.airportName) : false;
                if (m.airportName === selectedAirport) isForced = true;

                const pt = map.latLngToContainerPoint(m.getLatLng());

                // 最高优先级：被选中的，或航线必须显示的
                if (isForced) {
                    el.classList.remove('collapsed');
                    m.airportName === selectedAirport ? el.classList.add('selected') : el.classList.remove('selected');
                    occupiedPoints.push(pt); 
                    return;
                }

                // 进行空间碰撞检测
                let tooClose = false;
                if (!globalHasActiveFilter) {
                    
                    // 🌟 核心修改：动态计算每个机场专属的“生存半径”
                    // m.airportIndex 越小（排名越靠前），惩罚越小，dynamicMinPx 越接近基础值，越容易挤进地图。
                    // m.airportIndex 越大（排名越靠后），惩罚越大，必须周围极度空旷才能显示。
                    // 这里的 "3" 是惩罚系数，你可以根据实际观感微调（例如 2 到 5 之间）。
                    const dynamicMinPx = basePxDistance + (m.airportIndex * 3); 

                    for (let op of occupiedPoints) {
                        const dx = pt.x - op.x;
                        const dy = pt.y - op.y;
                        if (Math.sqrt(dx * dx + dy * dy) < dynamicMinPx) {
                            tooClose = true;
                            break;
                        }
                    }
                } else {
                    tooClose = true; 
                }

                // 更新 UI
                if (!tooClose) {
                    el.classList.remove('collapsed');
                    el.classList.remove('selected');
                    occupiedPoints.push(pt); 
                } else {
                    el.classList.add('collapsed');
                    el.classList.remove('selected');
                }
            });
        }
        
